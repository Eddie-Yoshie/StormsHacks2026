# Copy to .env.local to override. Both URLs are used by the browser, so they must be reachable from it.
# FastAPI backend (REST + /vision/ws WebSocket). If you open the dashboard from another host,
# also add that origin to the backend's CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:8000
# MediaMTX WebRTC (WHEP) server
VITE_MEDIAMTX_BASE_URL=http://localhost:8889
